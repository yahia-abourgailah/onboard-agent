# Copy to .env for local development: cp .env.example .env
# Real values per environment live in the platform's secret store, never in git.

# One of: development | staging | production
# NOTE: no ONBOARD_ prefix — see the env_prefix comment in config.py.
ENVIRONMENT=development
DEBUG=true
ALLOW_UNAUTHENTICATED=true

# OpenAI-compatible LLM endpoint (local vLLM server in prod).
OPENAI_API_KEY=
OPENAI_BASE_URL=
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
QDRANT_URL=http://localhost:6333
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Shared bearer token clients must send as: Authorization: Bearer <token>
# Generate one with: python token_generator.py
API_TOKEN=

# JSON list of browser origins allowed by CORS (empty = no cross-origin).
# Example: CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_ORIGINS=[]

#cost and rate limiting settings
RATE_LIMIT_ENABLED=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=

# Base URL the agent puts in floor-map links it hands back to the client.
# Must be the address the BROWSER can reach, not the container's own.
PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Deployment only — used by docker-compose.prod.yml, not by local runs.
# The compose file refuses to start if any of these are unset, so a missing
# secret stops the deploy instead of silently producing a broken service.
# ---------------------------------------------------------------------------
# Postgres superuser password. Compose builds POSTGRES_URL from it, so do NOT
# also set POSTGRES_URL when deploying with compose.
POSTGRES_PASSWORD=
